# ==========================================
# Comprehensive Git Ignore - Hostel Meal System
# Root Defense Level: Secrets & Environments
# ==========================================

# 1. Environment & Secret Credential Files (STRICTLY FORBIDDEN)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
.envrc

# 2. Cryptographic Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub
id_rsa*
secrets.json
credentials.json

# 3. Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 4. Logs and Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# 5. Next.js & Build Outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# 6. Operating System & Editor Metadata
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# 7. Testing & Coverage Reports
coverage/
.nyc_output/

# 8. Hosting & Deployments
.vercel
