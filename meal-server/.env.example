# ==========================================
# Meal Server Environment Variables Example
# Duplicate this file to .env and provide your secrets
# NEVER commit the real .env file to version control
# ==========================================

# Port for Express API server
PORT=5000

# MongoDB Atlas credentials & URI
DB_USER=your_db_user
DB_PASS=your_db_password
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/weekly-meal?retryWrites=true&w=majority

# Secret key used for signing and verifying JWT tokens (HS256) - Must match meal-client
JWT_SECRET=your_jwt_secret_min_32_chars_here

# Execution environment: 'development' or 'production'
NODE_ENV=development
