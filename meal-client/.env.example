# ==========================================
# Meal Client Environment Variables Example
# Duplicate this file to .env and provide your secrets
# NEVER commit the real .env file to version control
# ==========================================

# Secret key used for signing and verifying JWT session tokens (HS256)
JWT_SECRET=your_jwt_secret_min_32_chars_here

# MongoDB Atlas connection URI for Direct Server Actions
DB_URL=mongodb+srv://<db_user>:<db_password>@<cluster-host>/weekly-meal?retryWrites=true&w=majority

# Base URL for Express backend REST API
NEXT_PUBLIC_API_URL=http://localhost:5000/api
